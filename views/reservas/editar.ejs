<h1>Editar reserva</h1>

<p><%= seccion %></p>

<p>Modificá los datos de la reserva <strong><%= id %></strong> y guardá los cambios.</p>

<% if (error) { %>
    <p role="alert"><%= error %></p>
<% } %>

<form action="/reservas/<%= id %>/editar" method="POST">
    <label for="estudiante">Estudiante</label>
    <input
    type="text"
    id="estudiante"
    name="estudiante"
    value="<%= valores?.estudiante ?? '' %>"
    />

    <label for="email">Email</label>
    <input
    type="email"
    id="email"
    name="email"
    value="<%= valores?.email ?? '' %>"
    />

    <label for="sala">Sala</label>
        <select id="sala" name="sala">
            <option value="">Seleccioná una sala</option>
            <option value="Sala Norte" <%= valores?.sala === "Sala Norte" ? "selected" : "" %>>Sala Norte</option>
            <option value="Sala Sur" <%= valores?.sala === "Sala Sur" ? "selected" : "" %>>Sala Sur</option>
            <option value="Sala Multimedia" <%= valores?.sala === "Sala Multimedia" ? "selected" : "" %>>Sala Multimedia</option>
    </select>

    <label for="fecha">Fecha</label>
        <input
            type="date"
            id="fecha"
            name="fecha"
            value="<%= valores?.fecha ?? '' %>"
    />

    <label for="turno">Turno</label>
        <select id="turno" name="turno">
            <option value="">Seleccioná un turno</option>
            <option value="Mañana" <%= valores?.turno === "Mañana" ? "selected" : "" %>>Mañana</option>
            <option value="Tarde" <%= valores?.turno === "Tarde" ? "selected" : "" %>>Tarde</option>
            <option value="Noche" <%= valores?.turno === "Noche" ? "selected" : "" %>>Noche</option>
    </select>

    <label for="personas">Cantidad de personas</label>
        <input
            type="number"
            id="personas"
            name="personas"
            value="<%= valores?.personas ?? '' %>"
    />

    <label for="estado">Estado</label>
        <select id="estado" name="estado">
            <option value="">Seleccioná un estado</option>
            <option value="pendiente" <%= valores?.estado === "pendiente" ? "selected" : "" %>>pendiente</option>
            <option value="confirmada" <%= valores?.estado === "confirmada" ? "selected" : "" %>>confirmada</option>
    </select>

    <button type="submit">Guardar cambios</button>
    <a href="/reservas/<%= id %>">Cancelar</a>
</form>